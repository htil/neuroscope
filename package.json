{
  "name": "neuroblock-emg-mechdog",
  "description": "NeuroBlock EMG for MechDog",
  "version": "1.4.3",
  "author": {
    "name": "Human Technology Interaction Lab"
  },
  "keywords": [
    "electron",
    "electron vuejs parcel",
    "parcel",
    "vuejs",
    "vuejs3",
    "parcel2"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/a133xz/electron-vuejs-parcel-boilerplate.git"
  },
  "license": "MIT",
  "browserslist": [
    "electron >= 9.0.4"
  ],
  "targets": {
    "main": false
  },
  "scripts": {
    "serve": "concurrently \"cross-env BROWSER=none yarn vue:serve --port 3005\" \"wait-on http://localhost:3005 && cross-env NODE_ENV=development electron . \"",
    "build": "yarn vue:build",
    "vue:serve": "parcel ./src/renderer/index.html -p 3005 --dist-dir build/renderer-mechdog-emg",
    "vue:build": "cross-env NODE_ENV=production parcel build ./src/renderer/index.html --dist-dir build/renderer-mechdog-emg --public-url . --no-source-maps --no-scope-hoist",
    "python:build": ".\\.venv\\Scripts\\pyinstaller.exe VEXServer.spec --clean --noconfirm",
    "electron:build": "electron-builder build --win nsis",
    "build:local": "yarn build && yarn python:build && yarn electron:build",
    "build:win": "yarn build && yarn python:build && yarn electron:build",
    "clean": "rmdir build && rmdir .cache && rmdir dist && rmdir .parcel-cache",
    "patch": "npm version patch -m \"v%s\"",
    "postversion": "git push && git push --tags",
    "changelog": "github_changelog_generator -u a133xz -p electron-heic-png"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "2.0.0-beta.3.1",
    "@parcel/transformer-vue": "2.0.0-beta.3.1",
    "@vue/compiler-sfc": "^3.0.0",
    "concurrently": "^5.2.0",
    "cross-env": "^7.0.2",
    "electron": "^26.2.2",
    "electron-builder": "^22.11.7",
    "electron-debug": "^3.2.0",
    "electron-reloader": "^1.2.1",
    "parcel": "2.0.0-beta.3.1",
    "prettier": "^2.3.1",
    "sass": "^1.35.1",
    "typescript": "^4.3.2",
    "vue": "^3.0.0"
  },
  "main": "./src/main/index.js",
  "build": {
    "appId": "com.htil.neuroblock-emg-mechdog",
    "productName": "NeuroBlock EMG for MechDog",
    "compression": "maximum",
    "directories": {
      "output": "dist/ganglion-mechdog"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/icons/paw_icon.png",
      "build/renderer-mechdog-emg/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/MechDogServer.exe",
        "to": "python/MechDogServer.exe"
      },
      {
        "from": "resources/python/**/*",
        "to": "python/"
      }
    ],
    "mac": {
      "icon": "src/renderer/icons/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "icon": "src/renderer/icons/paw_icon.png"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "homepage": "./",
  "dependencies": {
    "@openbci/utilities": "^1.0.0",
    "blockly": "^10.4.3",
    "d3": "^7.9.0",
    "js-interpreter": "^5.1.1",
    "rxjs": "^7.8.1",
    "ws": "^8.18.2",
    "wait-on": "^5.3.0"
  }
}
